+     * Longer pairs use two individually bounded insertions. Byte output is
+     * alignment-safe and saturates exactly like TDEFL_PUT_BITS. */
+    static HUFF_NOINLINE mz_bool tdefl_compress_huffman_lz_codes(tdefl_compressor *d)
+    {
+        mz_uint32 table[257];
+        mz_uint i,bits_in=d->m_bits_in;
+        mz_uint32 bit_buffer=d->m_bit_buffer;
+        mz_uint8 *p=d->m_lz_code_buf,*last=d->m_pLZ_code_buf;
+        mz_uint8 *out=d->m_pOutput_buf,*end=d->m_pOutput_buf_end;
+        for(i=0;i<257;++i)
+            table[i]=(mz_uint32)d->m_huff_codes[0][i] | ((mz_uint32)d->m_huff_code_sizes[0][i]<<16);
+#define HUF_FLUSH_BYTES() do { \
+    while(bits_in>=8) { \
+        if(out<end) *out++=(mz_uint8)bit_buffer; \
+        bit_buffer>>=8;bits_in-=8; \
+    } \
+} MZ_MACRO_END
+#define HUF_ONE(v) do { \
+    mz_uint32 packed_code=(v); \
+    bit_buffer|=(packed_code&0xffffU)<<bits_in; \
+    bits_in+=packed_code>>16; \
+    HUF_FLUSH_BYTES(); \
+} MZ_MACRO_END
+        while(p<last)
