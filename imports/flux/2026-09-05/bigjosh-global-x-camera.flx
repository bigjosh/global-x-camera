cc54eb8193"}},"behaviour":"// Howdy 👋.\n//\n// This is where you can create powerful part automations like resistors that tell you when too much current is flowing through them\n// You can also create your own flexible parts, like generics (https://docs.flux.ai/Introduction/generic-parts)\n//\n// If you are new to writing code in Flux make sure to check out our get started docs: https://docs.flux.ai/reference/introduction\n//\n// To infinity and beyond 🚀","behaviour_has_errors":false,"behaviour_is_derived":false,"controls":{"_dataStructureIsArray":true},"created_at":1787181545205,"description":"Buck Switching Regulator IC Positive Fixed 3.3V 1 Output 3A 16-VFQFN Exposed Pad\n\nSynchronous Step-Down DC-DC Converter that provides a fixed 3.3 V output at up to 3 A from a 3 V to 17 V input. It operates at a selectable switching frequency of approximately 1.25 MHz or 2.5 MHz and integrates power-good, soft-start/tracking, power-save mode, short-circuit protection, and overtemperature protection in a 16-pin, 3 mm × 3 mm VQFN package. #DC-DC #BuckConverter #PowerManagement #TexasInstruments","document_import_uid":"7e1b987a-92a1-43eb-b378-79e365bd1db8","extracted_element_cache":{"0154b468-1777-4255-89d6-c956de998859":{"diagram_position":{"flip":true,"x":257,"y":-116},"label":"AVIN","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d645","version":"HEAD"},"properties":{"designator_prefix":{"name":"Designator Prefix","value":"P"},"e44dbfe5-3d5a-4bc5-8e8b-abbea7f26025":{"name":"Pin Orientation","value":"Top"},"part_type":{"name":"Part Type","value":"Terminal"},"pin_number":{"name":"Pin Number","value":"10"},"pin_type":{"name":"Pin Type","value":"Unspecified"},"symbol_pin_position":{"name":"Symbol Pin Position","value":{"data":{"x":85.5,"y":-14.5},"type":"vector2"}},"terminal_order":{"name":"Terminal Order","value":""}}},"07e7427f-b388-4314-8cbb-8c9187566d75":{"diagram_position":{"flip":false,"orientation":1.5707963267948966,"x":86,"y":-51