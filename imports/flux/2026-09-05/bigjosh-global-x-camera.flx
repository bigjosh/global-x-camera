humbnail":false,"label":"SML-P11MTT86R","name":"LEDC1006X25N.kicad_mod","rawName":"LEDC1006X25N.kicad_mod","storageName":"document_assets/LEDC1006X25N-c4de1627-098e-4a39-9ff6-5c1597d532dc.kicad_mod","uid":"7d2d9d5c-478b-4d5d-b140-d11cbea4ec12"},"82996772-fb59-4cef-a93d-7cf13cdf1319":{"fileType":"png","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":true,"label":"SML-P11MTT86R-thumb.png","name":"SML-P11MTT86R-thumb","rawName":"SML-P11MTT86R-thumb.png","storageName":"document_assets/SML-P11MTT86R-thumb-e3eb17fb-423c-46de-93de-12549a782a6f.png","uid":"82996772-fb59-4cef-a93d-7cf13cdf1319"},"af075013-2241-4e0d-9f39-5b98f7ae9c95":{"fileType":"svg","is3dModel":false,"isDefault":true,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"SML-P11MTT86R","name":"SML-P11MTT86R Symbol.svg","rawName":"SML-P11MTT86R Symbol.svg","storageName":"document_assets/SML-P11MTT86R-Symbol-0fdda19b-27a7-4569-8369-f6bfd09c028e.svg","uid":"af075013-2241-4e0d-9f39-5b98f7ae9c95"},"c81bcb5a-9b89-4fb2-adf8-86ac7a693f0f":{"fileType":"stp","is3dModel":true,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"SML-P11MTT86R","name":"SML-P11MTT86R.stp","rawName":"SML-P11MTT86R.stp","storageName":"document_assets/SML-P11MTT86R-58b4fdb5-4741-4b57-8e41-bcf0a5a155e8.stp","uid":"c81bcb5a-9b89-4fb2-adf8-86ac7a693f0f"}},"behaviour":"// Howdy 👋.\n//\n// This is where you can create powerful part automations like resistors that tell you when too much current is flowing through them\n// You can also create your own flexible parts, like generics (https://docs.flux.ai/Introduction/generic-parts)\n//\n// If you are new to writing code in Flux make sure to check out our get started docs: https://docs.flux.ai/reference/introduction\n//\n// To infinity and beyond 🚀","behaviour_has_errors":false,"behaviour_is_derived":false,"controls":{"_dataStructureIsArray":true},"created_at":1787181322870,"description":"Low-Current Chip LED – Yellow-green surface-mount LED for status indication, portable electronics, industrial equipment, and wearable devices. Features a 569 nm dominant wavelength, 1.9 V typical forward voltage at 1 mA, and 2.1 mcd typical luminous intensity. Built using AlGaInP technology, it is optimized for low-current operation (1 mA typical) to minimize power consumption. Packaged in an ultra-small 0402 (1006 Metric, 1.0 × 0.6 × 0.2 mm) clear molded package for high-density PCB designs. Specified for operation over a −40°C to +85°C temperature range with a 54 mW maximum power dissipation.\n\n#ROHM #SMLP11MTT86R #PICOLED #ChipLED #YellowGreenLED #0402LED #SMDLED #IndicatorLED #LowCurrentLED #AlGaInP #Optoelectronics #EmbeddedSystems","document_import_uid":"0dd815ae-b17c-4ecd-b262-fd16c7331add","extracted_element_cache":{"0de8aed5-e8fa-4b2b-a692-628b34ebae6c":{"diagram_position":{"flip":true,"x":129,"y":0},"label":"~","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d645","version":"HEAD"},"properties":{"designator_prefix":{"name":"Designator Prefix","value":"P"},"part_type":{"name":"Part Type","value":"Terminal"},"pin_number":{"name":"Pin Number","value":"2"},"pin_type":{"name":"Pin Type","value":"Unspecified"},"symbol_pin_position":{"name":"Symbol Pin Position","value":{"data":{"x":43,"y":-7.5},"type":"vector2"}},"terminal_order":{"name":"Terminal Order","value":""}}},"147bb74b-3f07-45aa-83e7-58585639d53e":{"diagram_position":{"flip":false,"x":0,"y":0},"label":"~","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d645","version":"HEAD"},"properties":{"designator_prefix":{"name":"Designator Prefix","value":"P"},"part_type":{"name":"Part Type","value":"Terminal"},"pin_number":{"name":"Pin Number","value":"1"},"pin_type":{"name":"Pin Type","value":"Unspecified"},"symbol_pin_position":{"name":"Symbol Pin Position","value":{"data":{"x":-43,"y":-7.5},"type":"vector2"}},"terminal_order":{"name":"Term