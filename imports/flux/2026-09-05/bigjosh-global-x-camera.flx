3a7":{"name":"Role","uid":"7a394927-11ad-444f-a039-f3827b9dc3a7","value":"Power ORing"},"82279aaf-96bd-445b-bb9b-d7202331a14e":{"name":"Forward Voltage","order":9,"uid":"82279aaf-96bd-445b-bb9b-d7202331a14e","unit":"V","value":"0.3V to 0.45V"},"855ad4f2-b6b7-4574-aa0d-f95f19b5715a":{"name":"Role Details","uid":"855ad4f2-b6b7-4574-aa0d-f95f19b5715a","value":"Blocks battery/system input from backfeeding USB VBUS; 40V 3A Schottky."},"8d57e48a-f0c5-466d-90ae-f267d6a326e6":{"name":"Package or Case Code","order":4,"uid":"8d57e48a-f0c5-466d-90ae-f267d6a326e6","value":"SMB_L4.3-W3.6-LS5.4-RD"},"df3674e8-5f93-4fc2-a949-936cd418eec6":{"name":"Functional Group","order":13,"uid":"df3674e8-5f93-4fc2-a949-936cd418eec6","value":"Battery Latch and Power ORing,USB-C and ESD"},"dfd18b0a-855a-4a2d-99ee-29c853c3d033":{"name":"JLCPCB Part Class","order":6,"uid":"dfd18b0a-855a-4a2d-99ee-29c853c3d033","value":"Extended Part"},"e9f7c2ea-204f-4e7e-9775-db1c013de095":{"name":"Manufacturer Part Number","order":2,"uid":"e9f7c2ea-204f-4e7e-9775-db1c013de095","value":"SS34"}},"symbol_placements":{"MAIN":{"x":2956,"y":-77.5}},"uid":"50d08f79-6656-4fb2-8469-712c6d9abffc","updated_at":1787181323210},"516cb65e-bdee-4a29-902f-7d27f54d7b6b":{"created_at":1787183523174,"diagram_position":{"x":0,"y":0},"label":"TP3","owner_uid":"ZlptFyOgRpgjoGMu10HDsDK5rgO2","part_uid":"cc313bba-fef2-4bbe-97b1-3f73a00a1c2d","part_version":"c476ed14-e8a6-4fc4-8762-2d33480ede7b","part_version_data_cache":{"assets":{"ad78f435-d26e-4ed3-a960-33e3673a3999":{"fileType":"svg","is3dModel":false,"isDefault":true,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":true,"label":"test-point.svg","name":"test-point","rawName":"testpoint.svg","storageName":"document_assets/testpoint-5c6338c0-265b-4a50-985b-029a00fe7f17.svg","uid":"ad78f435-d26e-4ed3-a960-33e3673a3999"}},"behaviour":"const terminalPadId = \"e9cbb998-688e-40c0-820b-08a1f688dcc6\"; // This has two nodes, one in schematic and for PCB. We only want the PCB node\nconst silkCircleId = \"a3e22c3e-0ca0-44fa-8711-8644c5a86e41\";\nconst silkTextId = \"087763aa-d4a5-492b-9426-ff893056220a\";\n\n// First cast to unknown, then to BaseNodeMixin\nconst terminalPadNode = flux.nodes.find((node) => {\n    const n = node as unknown as BaseNodeMixin; // Cast to unknown first, then to BaseNodeMixin\n    return n.id === terminalPadId && n.type === \"pcbLayoutNode\";\n}) as PcbLayoutNode | undefined;\n\nconst silkCircleNode = flux.getNodeById(silkCircleId) as PcbLayoutNode;\nconst textNodePosition = flux.getNodeById(silkTextId) as PcbLayoutNode;\n\n\n// Check if both terminalPadNode, silkCircleNode, textNodePosition are defined\nif (terminalPadNode && silkCircleNode && textNodePosition) {\n    const sizeRuleOfThePad = terminalPadNode.rules.find((rule) => rule.key === \"size\");\n    const sizeRuleOfTheCircleSilk = silkCircleNode.rules.find((rule) => rule.key === \"size\");\n    const positionRuleOfTheTextSilk = textNodePosition.rules.find((rule) => rule.key === \"positionY\");\n\n    flux.on(\"setup\", () => {\n        const property = flux.properties.find((prop) => prop.name === \"Testpoint Size\");\n        if (property) {\n            changeThePadSize(property.value);\n        };\n    });\n\n    flux.on(\"propertyChange\", (event: PropertyChangeEvent) => {\n        if (event.property_name === \"Testpoint Size\") {\n            changeThePadSize(event.value);\n        };\n    });\n\n    function changeThePadSize(newSelectedValue: any) {\n        // Check if newSelectedValue is null, undefined, or empty, and set defaults if so\n        if (!newSelectedValue || newSelectedValue === \"\") {\n            newSelectedValue = \"1\"; // Default value for pad and text position Y\n        };\n\n        const newValue = parseFloat(newSelectedValue);\n\n        if (newValue >= 0.5 && newValue <= 10) {  // Ensure that the value is within the 1 to 10 range\n            if (sizeRuleOfThePad && sizeRuleOfTheCircleSilk && positionRuleOfTheTextSilk) {\n                // Update the pad size and silk circle size based on the property value\n                sizeRuleOfThePad.value = newValue.toString();\n                sizeRuleOfTheCircleSilk.value = (newValue + 0.5).toString();\n\n                // Update the Y position\n                const positionY = newValue / 2 + 1.5;  \n                positionRuleOfTheTextSilk.value = positionY.toString();\n            };\n        };\n    };\n};","behaviour_has_errors":false,"behaviour_is_derived":false,"controls":{"_dataStructureIsArray":true},"created_at":1781027472210,"description":"This is a generic test point with a circular pad, used to either monitor the state of the circuitry or to inject test signals, and debugging during development. The footprint size is selectable.\n\nStandard SMD test point size available: 0.5mm, 0.6mm, 0.7mm, 0.8mm, 0.9mm, 1.0mm, 2.0mm, 3.00mm, 4.00mm, 5.00mm, 6.00mm, 7.00mm","document_import_uid":"8db26db2-a266-470f-b953-6d09b4b44ef0","extracted_element_cache":{"e9cbb998-688e-40c0-820b-08a1f688dcc6":{"diagram_position":{"flip":false,"orientation":0,"scene_cursor_position":true,"x":9,"y":17.5},"label":"P1","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d645","version":"HEAD"},"properties":{"designator_prefix":{"name":"Designator Prefix","value":"P"},"part_type":{"name":"Part Type","value":"Terminal"},"pin_number":{"name":"Pin Number","value":"1"},"pin_type":{"name":"Pin Type","value":"Unspecified"},"symbol_pin_position":{"name":"Symbol Pin Position","value":{"data":{"x":0,"y":-10},"type":"vector2"}},"terminal_order":{"name":"Terminal Order","value":""}}}},"has_custom_name":true,"is_original":true,"name":"Generic Testpoint","owner_uid":"BvvmCewoPEamxFYjB0c5ERKB6rt1","part_uid":"cc313bba-fef2-4bbe-97b1-3f73a00a1c2d","pcbLayoutNodes":{"087763aa-d4a5-492b-9426-ff893056220a":{"name":"","parentUid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint","pcbNodeRuleSet":{"content":{"key":"content","order":2,"uid":"ff3823e9-d548-4a33-accc-e2ea1157dcce","value":"=this.element.designator"},"fontSize":{"key":"fontSize","order":4,"uid":"b79b69ad-6a6f-4682-9307-e1964af98167","value":"0.8"},"positionY":{"key":"positionY","order":3,"uid":"30601dfc-7bb3-4e48-acb9-a891a4e02bcd","value":"1.3"},"textAlign":{"key":"textAlign","order":3,"uid":"883cb94a-abc1-417b-ba83-4c7f12162bb0","value":"center"}},"type":"text","uid":"087763aa-d4a5-492b-9426-ff893056220a"},"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint":{"name":"Footprint","parentUid":"ROOT","pcbNodeRuleSet":{},"type":"footprint","uid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint"},"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint.Pads":{"name":"Pads","parentUid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint","pcbNodeRuleSet":{},"type":"container","uid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint.Pads"},"ROOT":{"name":"Root","parentUid":"PARENT_OF_ROOT","pcbNodeRuleSet":{},"type":"root","uid":"ROOT"},"a3e22c3e-0ca0-44fa-8711-8644c5a86e41":{"name":"Circle Shape","parentUid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint","pcbNodeRuleSet":{"size":{"key":"size","order":2,"uid":"853413f6-037a-43c5-a55c-734e60be1141","value":"1"},"strokeWidth":{"key":"strokeWidth","order":2,"uid":"4e874a21-7855-4a92-ae21-222589bfffae","value":"0.1"}},"type":"circle","uid":"a3e22c3e-0ca0-44fa-8711-8644c5a86e41"},"e9cbb998-688e-40c0-820b-08a1f688dcc6":{"name":"P1","parentUid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint.Pads","pcbNodeRuleSet":{"padShape":{"key":"padShape","order":2,"uid":"4c46424d-18a7-49ef-8c8a-2358df1d5c65","value":"circular"},"size":{"key":"size","order":2,"uid":"48957c7e-5271-4483-9c06-c9c6ee95de43","value":"0.5"}},"terminalId":"1","type":"pad","uid":"e9cbb998-688e-40c0-820b-08a1f688dcc6"}},"pcbLayoutRuleSets":{},"preview_image":"document_assets/testpoint-5c6338c0-265b-4a50-985b-029a00fe7f17.svg","properties":{"36048bcc-a954-4204-8d53-721a7ea1ed0a":{"customAutocompleteOptions":{"0"