ition":{"x":0,"y":0},"label":"D1","owner_uid":"ZlptFyOgRpgjoGMu10HDsDK5rgO2","part_uid":"7b36beaf-0f82-4dc4-82ec-b684d621a657","part_version":"79038156-391d-46b2-997a-40132df80189","part_version_data_cache":{"assets":{"35efc0fd-367b-4721-8346-4534db3f4609":{"fileType":"png","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":true,"label":"SOT-23-6.png","name":"SOT-23-6","rawName":"SOT-23-6.png","storageName":"document_assets/SOT-23-6-1ddce80a-4822-4ba3-95c0-52b9910bcf79.png","uid":"35efc0fd-367b-4721-8346-4534db3f4609"},"520dba55-571a-4e2c-a93e-67de91140afc":{"fileType":"svg","is3dModel":false,"isDefault":true,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"USBLC6-2SC6_C2687116 Symbol.svg","name":"USBLC6-2SC6_C2687116 Symbol","rawName":"USBLC6-2SC6_C2687116 Symbol.svg","storageName":"document_assets/USBLC6-2SC6_C2687116-Symbol-66814462-a84f-4463-b6f2-2fc572fe7cc7.svg","uid":"520dba55-571a-4e2c-a93e-67de91140afc"},"5ea2f36e-04ac-4363-8641-dcf79f9aa7a8":{"fileType":"kicad_mod","is3dModel":false,"isDefault":false,"isFootprint":true,"isPcbBoardShape":false,"isThumbnail":false,"label":"USBLC6-2SC6/USBLC6-2SC6.pretty/SOT-23-6_L2.9-W1.6-P0.95-LS2.8-BL.kicad_mod","name":"USBLC6-2SC6/USBLC6-2SC6 Footprint","rawName":"USBLC6-2SC6/USBLC6-2SC6.pretty/SOT-23-6_L2.9-W1.6-P0.95-LS2.8-BL.kicad_mod","storageName":"document_assets/USBLC6-2SC6-USBLC6-2SC6.pretty-SOT-23-6_L2.9-W1.6-P0.95-LS2.8-BL-76ec8394-7299-41fa-998b-619058a71198.kicad_mod","uid":"5ea2f36e-04ac-4363-8641-dcf79f9aa7a8"},"c14ee63e-9ca9-4df1-916e-b3017da569de":{"fileType":"step","is3dModel":true,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"USBLC6-2SC6/USBLC6-2SC6.3dshapes/SOT-23-6_L2.9-W1.6-H1.5-LS2.8-P0.95.step","name":"USBLC6-2SC6/USBLC6-2SC6 Model","rawName":"USBLC6-2SC6/USBLC6-2SC6.3dshapes/SOT-23-6_L2.9-W1.6-H1.5-LS2.8-P0.95.step","storageName":"document_assets/USBLC6-2SC6-USBLC6-2SC6.3dshapes-SOT-23-6_L2.9-W1.6-H1.5-LS2.8-P0.95-47304225-a37c-4a02-8044-1ee76a7a3e74.step","uid":"c14ee63e-9ca9-4df1-916e-b3017da569de"}},"behaviour":"// Howdy 👋.\n//\n// This is where you can create powerful part automations like resistors that tell you when too much current is flowing through them\n// You can also create your own flexible parts, like generics (https://docs.flux.ai/Introduction/generic-parts)\n//\n// If you are new to writing code in Flux make sure to check out our get started docs: https://docs.flux.ai/reference/introduction\n//\n// We also have a Flux Slack Community in case you need help: https://join.slack.com/t/fluxcommunity/shared_invite/zt-2ouyf80w6-7Wp81YlNEsuDFFdED9UQMA\n//\n// To infinity and beyond 🚀","behaviour_has_errors":false,"behaviour_is_derived":false,"controls":{"_dataStructureIsArray":true},"created_at":1787181322801,"description":"ESD DIODE 15VC SOT-23-6 \nThe UMW USBLC6-2SC6 is a low-capacitance TVS/ESD protection diode array designed to protect high-speed data interfaces such as USB 2.0 and Ethernet from electrostatic discharge (ESD), electrical fast transients (EFT), and surge events. It integrates dual protection channels in a compact SOT-23-6 package, making it suitable for space-constrained portable and embedded designs.\n\nKey Features\nDual-line ESD protection for high-speed signal interfaces\nSupports USB 2.0, 10/100 Ethernet, and other sensitive data lines\nVery low capacitance (~0.8 pF typical) to preserve signal integrity\nOperating voltage: 5 V\nLow clamping voltage for improved downstream IC protection\nIEC 61000-4-2 ESD protection:\n±30 kV air discharge\n±30 kV contact discharge\nIEC 61000-4-4 EFT protection up to 40 A (5/50 ns)\nIEC 61000-4-5 surge protection up to 6 A (8/20 µs)\nPeak pulse power capability: 150 W\nUltra-low leakage current in the nA range\nFast response time (<1 ns typical)\nCompact SOT-23-6 surface-mount package\nRoHS, Pb-free, and halogen-free compliant\nTypical Applications\nUSB data line protection\nEthernet interfaces\nPortable electronics\nNotebook and desktop PCs\nDigital cameras\nEmbedded systems and microcontroller USB ports\n\n#CommonPartsLibrary #TVS-Diode","document_import_uid":"7b36beaf-0f82-4dc4-82ec-b684d621a657","extracted_element_cache":{"19dba604-c21a-4c76-bb64-e8bade5fca74":{"diagram_position":{"flip":false,"orientation":4.71238898038469,"x":-6.35,"y":104.7},"label":"VBUS","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d645","version":"HEAD"},"properties":{"0027e3f0-98cd-43ce-bb05-e565b40cfea2":{"name":"Pin Orientation","value":"Top"},"designator_prefix":{"name":"Designator Prefix","value":"P"},"part_type":{"name":"Part Type","value":"Terminal"},"pin_number":{"name":"Pin Number","value":"5"},"pin_type":{"name":"Pin Type","value":"Unspecified"},"symbol_pin_position":{"name":"Symbol Pin Position","value":{"data":{"x":64,"y":0},"type":"vector2"}},"terminal_order":{"name":"Terminal Order","value":"1"},"terminal_type":{"name":"Terminal Type","value":"unspecified"}}},"1abd2c12-85c1-4ba3-a893-3dca139cfb97":{"diagram_position":{"flip":true,"orientation":4.71238898038469,"x":-6.35,"y":-109.8},"label":"GND","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d645","version":"HEAD"},"properties":{"ad3b96fb-58e1-4404-ace7-e278c5434592":{"name":"Pin Orientation","value":"Bottom"},"designator_prefix":{"name":"Designator Prefix","value":"P"},"part_type":{"name":"Part Type","value":"Terminal"},"pin_number":{"name":"Pin Number","value":"2"},"pin_type":{"name":"Pin Type","value":"Unspecified"},"symbol_pin_position":{"name":"Symbol Pin Position","value":{"data":{"x":-64,"y":0},"type":"vector2"}},"terminal_order":{"name":"Terminal Order","value":"4"},"terminal_type":{"name":"Terminal Type","value":"unspecified"}}},"7019c050-6a9e-46c6-91cc-d7c0619c9b84":{"diagram_position":{"flip":true,"x":-96,"y":56},"label":"I/O1","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a3