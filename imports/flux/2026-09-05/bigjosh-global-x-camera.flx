ad_mod","uid":"f415da93-8a0d-48a9-b039-87a2a5e9d8e3"},"f51e647d-f049-d308-39c9-9281e1a1cd63":{"fileType":"svg","isDefault":false,"isThumbnail":false,"label":"polarized-cap","name":"polarized-cap","rawName":"polarized-cap.svg","storageName":"document_assets/polarized-cap-37900753-12a8-31ba-520a-57d33f721c9b.svg","uid":"f51e647d-f049-d308-39c9-9281e1a1cd63"},"f5ae9da6-7891-459d-ada7-ab5ef6f33454":{"fileType":"step","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"3DC_Disc_D7.5mm_W4.4mm_P5.00mm.step","name":"3DC_Disc_D7.5mm_W4.4mm_P5.00mm","rawName":"3DC_Disc_D7.5mm_W4.4mm_P5.00mm.step","storageName":"document_assets/3DC_Disc_D7.5mm_W4.4mm_P5.00mm-5fad0bde-c77b-459c-a7aa-8029533e020f.step","uid":"f5ae9da6-7891-459d-ada7-ab5ef6f33454"},"fa1fdb5a-6997-4134-8456-4ec83a9e8d23":{"fileType":"step","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"3DC_Disc_D5.1mm_W3.2mm_P5.00mm.step","name":"3DC_Disc_D5.1mm_W3.2mm_P5.00mm","rawName":"3DC_Disc_D5.1mm_W3.2mm_P5.00mm.step","storageName":"document_assets/3DC_Disc_D5.1mm_W3.2mm_P5.00mm-d72b4d7f-da10-4349-af32-7bac590604d5.step","uid":"fa1fdb5a-6997-4134-8456-4ec83a9e8d23"},"fc66f14c-d051-4fa2-b2fe-082bd1b7d710":{"fileType":"step","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"3DC_Disc_D9.0mm_W2.5mm_P5.00mm.step","name":"3DC_Disc_D9.0mm_W2.5mm_P5.00mm","rawName":"3DC_Disc_D9.0mm_W2.5mm_P5.00mm.step","storageName":"document_assets/3DC_Disc_D9.0mm_W2.5mm_P5.00mm-e92c1464-ae22-4d0e-bfae-1ac3a93dcd0c.step","uid":"fc66f14c-d051-4fa2-b2fe-082bd1b7d710"},"fce681ad-fc52-d6c7-030d-e55d23d41d33":{"fileType":"step","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"3DCP_Elec_6.3x5.4.step","name":"3DCP_Elec_6.3x5.4","rawName":"3DCP_Elec_6.3x5.4.step","storageName":"document_assets/3DCP_Elec_6.3x5.4-69a6d39d-f48a-4be1-9350-ccd41bbd035a.step","uid":"fce681ad-fc52-d6c7-030d-e55d23d41d33"},"ff4cd96e-f644-e9cd-3799-ef0d17357fa8":{"fileType":"kicad_mod","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"CP_Elec_8x6.2.kicad_mod","name":"CP_Elec_8x6.2","rawName":"CP_Elec_8x6.2.kicad_mod","storageName":"document_assets/CP_Elec_8x6.2-ee042c58-9f52-af31-a508-7b2aaf431ae6.kicad_mod","uid":"ff4cd96e-f644-e9cd-3799-ef0d17357fa8"}},"behaviour":"const footprintNode = flux.getNodeById(\"400f1db7-c03a-a15d-513d-e6da15e7a2f9\") as PcbLayoutNode;\nconst modelNode = flux.getNodeById(\"7c93bbd4-43d8-8bcb-8099-3fe6995b7052\") as PcbLayoutNode;\n\n// This will return array of all assets with file type .kicad_mod\nconst footprintAssetId = flux.assets\n    .filter((asset) => asset.fileType === \"kicad_mod\") // Filter by file type\n    .map((asset) => asset.name) // Extract the name\n    .sort(); // Sort the resulting names\n\n// This will return array of all assets with file type .step\nconst modelAssetId = flux.assets\n    .filter((asset) => asset.fileType === \"step\") // Filter by file type\n    .map((asset) => asset.name) // Extract the name\n    .sort(); // Sort the resulting names\n\nif (footprintNode || modelNode) {\n    const assetFootprintRule = footprintNode.rules.find((rule) => rule.key === \"asset\");\n    const assetModelRule = modelNode.rules.find((rule) => rule.key === \"asset\");\n\n    flux.on(\"setup\", () => {\n        const property = flux.properties.find((prop) => prop.name === \"Package\");\n        if (property) {\n            changeFootprintAsset(property.value);\n            changeModelAsset(property.value)\n        }\n    });\n\n    flux.on(\"propertyChange\", (event: PropertyChangeEvent) => {\n        if (event.property_name === \"Package\") {\n            changeFootprintAsset(event.value);\n            changeModelAsset(event.value);\n        }\n    });\n\n    function changeFootprintAsset(propertyValue: any) {\n        if (assetFootprintRule) {\n            const index = footprintAssetId.indexOf(propertyValue);\n            if (index >= 0 && index <= 52) {\n                assetFootprintRule.value = footprintAssetId[index];\n                footprintNode.name = footprintAssetId[index];\n            } else {\n                assetFootprintRule.value = \"SMD_0603_1608Metric\";\n                footprintNode.name = \"SMD_0603_1608Metric\";\n            }\n        }\n    };\n\n    function changeModelAsset(propertyValue: any) {\n        if (assetModelRule) {\n            const index = footprintAssetId.indexOf(propertyValue);\n            if (index >= 0 && index <= 52) {\n                assetModelRule.value = modelAssetId[index];\n                modelNode.name = modelAssetId[index];\n            } else {\n                assetModelRule.value = \"3DSMD_0603_1608Metric\";\n                modelNode.name = \"3DSMD_0603_1608Metric\";\n            }\n        }\n    };       \n};","behaviour_has_errors":false,"behaviour_is_derived":false,"controls":{"_dataStructureIsArray":true},"created_at":1781027146944,"description":"A generic fixed capacitor ideal for rapid circuit topology development. You can choose between polarized and non-polarized types, its symbol and the footprint will automatically adapt based on your selection. Supported options include standard SMD sizes for ceramic capacitors (e.g., 0402, 0603, 0805), SMD sizes for aluminum electrolytic capacitors, and through-hole footprints for polarized capacitors. \n\nSave precious design time by seamlessly add more information to this part (value, footprint, etc.) as it becomes available.\n\nStandard capacitor values: 1.0pF, 10pF, 100pF, 1000pF, 0.01uF, 0.1uF, 1.0uF, 10uF, 100uF, 1000uF, 10000uF\n1.1pF, 11pF, 110pF, 1100pF\n1.2pF, 12pF, 120pF, 1200pF\n1.3pF, 13pF, 130pF, 1300pF\n1.5pF, 15pF, 150pF, 1500pF, 0.015uF, 0.15uF, 1.5uF, 15uF, 150uF, 1500uF\n1.6pF, 16pF, 160pF, 1600pF\n1.8pF, 18pF, 180pF, 1800pF\n2.0pF, 20pF, 200pF, 