storageName":"document_assets/TLV70033DDCT-TLV70033DDCT.pretty-SOT-23-5_L2.9-W1.6-P0.95-LS2.8-BR-24787882-7b41-4490-a4ec-023ddf1e3e84.kicad_mod","uid":"e46099ac-33d4-4d19-80ed-353b54b05f82"},"f5a295bd-55ae-447f-841c-d93215b2af34":{"fileType":"svg","is3dModel":false,"isDefault":true,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"TLV70033DDCT Symbol.svg","name":"TLV70033DDCT Symbol","rawName":"TLV70033DDCT Symbol.svg","storageName":"document_assets/TLV70033DDCT-Symbol-0bb60dc1-1f33-4dcb-8bec-9861eee23b24.svg","uid":"f5a295bd-55ae-447f-841c-d93215b2af34"}},"behaviour":"// Howdy 👋.\n//\n// This is where you can create powerful part automations like resistors that tell you when too much current is flowing through them\n// You can also create your own flexible parts, like generics (https://docs.flux.ai/Introduction/generic-parts)\n//\n// If you are new to writing code in Flux make sure to check out our get started docs: https://docs.flux.ai/reference/introduction\n//\n// We also have a Flux Slack Community in case you need help: https://join.slack.com/t/fluxcommunity/shared_invite/zt-2ouyf80w6-7Wp81YlNEsuDFFdED9UQMA\n//\n// To infinity and beyond 🚀","behaviour_has_errors":false,"behaviour_is_derived":false,"controls":{"_dataStructureIsArray":true},"created_at":1787181322886,"description":"200mA, high PSRR, low IQ, low dropout voltage regulator with enable function\n\nThe Texas Instruments TLV700 is a series of 200-mA low-dropout (LDO) linear voltage regulators designed for portable and battery-powered devices. It features very low quiescent current (IQ), low dropout voltage, and high power-supply rejection ratio (PSRR), making it suitable for applications requiring efficient and stable voltage regulation with minimal power loss. The device is optimized for handheld electronics, wireless modules, IoT systems, and other low-power embedded applications.\n\nKey Features\n200-mA output current capability\nVery low dropout voltage:\n43 mV at 50 mA load\n85 mV at 100 mA load\n175 mV at 200 mA load\nLow quiescent current: typically 31 µA\nHigh PSRR: 68 dB at 1 kHz\nOutput voltage accuracy of ±2%\nFixed output voltage options from 1.2 V to 4.8 V\nStable with small 0.1-µF output capacitors\nIntegrated thermal shutdown and overcurrent protection\nAvailable in compact SON-6, SOT-23-5, and SC-70 packages\nSuitable for battery-operated and portable electronics\nTypical Applications\nSmartphones and handheld devices\nBluetooth and ZigBee modules\nIoT and wearable devices\nWLAN modules and add-on cards\nBattery-powered embedded systems\nPortable consumer electronics\n\n#CommonPartsLibrary #IntegratedCircuit #PowerManagement #LDO","document_import_uid":"470ac661-f2ed-498d-b96c-cdd2072a848b","extracted_element_cache":{"00d6e489-1a96-4896-91d0-025167b5d388":{"diagram_position":{"flip":true,"x":-75,"y":0},"label":"GND","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d645","version":"HEAD"},"properties":{"55d2c649-17d2-4796-b42a-6826a1145131":{"name":"Pin Orientation","value":"Bottom"},"designator_prefix":{"name":"Designator Prefix","value":"P"},"part_type":{"name":"Part Type","value":"Terminal"},"pin_number":{"name":"Pin Number","value":"2"},"pin_type":{"name":"Pin Type","value":"Unspecified"},"symbol_pin_position":{"name":"Symbol Pin Position","value":{"data":{"x":-50,"y":0},"type":"vector2"}},"terminal_order":{"name":"Terminal Order","value":"3"},"terminal_type":{"name":"Terminal Type","value":"unspecified"}}},"2e97c7d9-77e1-444c-ae0a-4c8dba4b089d":{"diagram_position":{"flip":true,"x":-75,"y":-56},"label":"EN","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d645","version":"HEAD"},"properties":{"93011b53-0a4b-4923-afcf-532457f7658f":{"name":"Pin Orientation","value":"Left"},"designator_prefix":{"name":"Designator Prefix","value":"P"},"part_type":{"name":"Part Type","value":"Terminal"},"pin_number":{"name":"Pin Number","value":"3"},"pin_type":{"