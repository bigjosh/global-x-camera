4279-8af6-ea65d918b511","value":"PCB"},"87eccbca-4f89-427f-9778-7b5992878576":{"name":"Exclude from PCB","uid":"87eccbca-4f89-427f-9778-7b5992878576","value":"true"},"8f4d5cd4-2e3c-4041-906c-d43b9da0f51f":{"name":"Role Details","uid":"8f4d5cd4-2e3c-4041-906c-d43b9da0f51f","value":"External CAM-5G0-079CLR promodule; electrically modeled, no guessed production footprint; mates through J3."},"b20ddb41-a33c-4a12-9945-6cb78f9811f7":{"name":"Part Type","order":2,"uid":"b20ddb41-a33c-4a12-9945-6cb78f9811f7","value":""},"c01f1cf6-1a4b-4000-bd96-3da340f4fa52":{"name":"Datasheet URL","order":3,"uid":"c01f1cf6-1a4b-4000-bd96-3da340f4fa52","value":{"text":"https://www.st.com/en/evaluation-tools/cam-55g0.html","type":"link","url":"https://www.st.com/en/evaluation-tools/cam-55g0.html"}},"c8e3664d-9fc7-435b-9b61-b613b65223be":{"name":"Manufacturer Part Number","order":0,"uid":"c8e3664d-9fc7-435b-9b61-b613b65223be","value":"CAM-5G0-079CLR"},"e0bb0ce5-07a3-4889-9add-8d6fdcb6f35a":{"name":"Role","uid":"e0bb0ce5-07a3-4889-9add-8d6fdcb6f35a","value":"Image Sensor Module"},"fd6831fc-ceb6-4d6f-8e52-c4ebcd3e8c2e":{"name":"Manufacturer Name","order":1,"uid":"fd6831fc-ceb6-4d6f-8e52-c4ebcd3e8c2e","value":"STMicroelectronics"}},"symbol_placements":{"MAIN":{"x":115,"y":-16382.7}},"uid":"9f62bd5d-5dc4-41bc-8603-462e0b02eef7","updated_at":1787203037004},"a05f6810-716b-4081-8101-74164abb3f60":{"created_at":1787183523175,"diagram_position":{"x":0,"y":0},"label":"TP4","owner_uid":"ZlptFyOgRpgjoGMu10HDsDK5rgO2","part_uid":"cc313bba-fef2-4bbe-97b1-3f73a00a1c2d","part_version":"c476ed14-e8a6-4fc4-8762-2d33480ede7b","part_version_data_cache":{"assets":{"ad78f435-d26e-4ed3-a960-33e3673a3999":{"fileType":"svg","is3dModel":false,"isDefault":true,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":true,"label":"test-point.svg","name":"test-point","rawName":"testpoint.svg","storageName":"document_assets/testpoint-5c6338c0-265b-4a50-985b-029a00fe7f17.svg","uid":"ad78f435-d26e-4ed3-a960-33e3673a3999"}},"behaviour":"const terminalPadId = \"e9cbb998-688e-40c0-820b-08a1f688dcc6\"; // This has two nodes, one in schematic and for PCB. We only want the PCB node\nconst silkCircleId = \"a3e22c3e-0ca0-44fa-8711-8644c5a86e41\";\nconst silkTextId = \"087763aa-d4a5-492b-9426-ff893056220a\";\n\n// First cast to unknown, then to BaseNodeMixin\nconst terminalPadNode = flux.nodes.find((node) => {\n    const n = node as unknown as BaseNodeMixin; // Cast to unknown first, then to BaseNodeMixin\n    return n.id === terminalPadId && n.type === \"pcbLayoutNode\";\n}) as PcbLayoutNode | undefined;\n\nconst silkCircleNode = flux.getNodeById(silkCircleId) as PcbLayoutNode;\nconst textNodePosition = flux.getNodeById(silkTextId) as PcbLayoutNode;\n\n\n// Check if both terminalPadNode, silkCircleNode, textNodePosition are defined\nif (terminalPadNode && silkCircleNode && textNodePosition) {\n    const sizeRuleOfThePad = terminalPadNode.rules.find((rule) => rule.key === \"size\");\n    const sizeRuleOfTheCircleSilk = silkCircleNode.rules.find((rule) => rule.key === \"size\");\n    const positionRuleOfTheTextSilk = textNodePosition.rules.find((rule) => rule.key === \"positionY\");\n\n    flux.on(\"setup\", () => {\n        const property = flux.properties.find((prop) => prop.name === \"Testpoint Size\");\n        if (property) {\n            changeThePadSize(property.value);\n        };\n    });\n\n    flux.on(\"propertyChange\", (event: PropertyChangeEvent) => {\n        if (event.property_name === \"Testpoint Size\") {\n            changeThePadSize(event.value);\n        };\n    });\n\n    function changeThePadSize(newSelectedValue: any) {\n        // Check if newSelectedValue is null, undefined, or empty, and set defaults if so\n        if (!newSelectedValue || newSelectedValue === \"\") {\n            newSelectedValue = \"1\"; // Default value for pad and text position Y\n        };\n\n        const newValue = parseFloat(newSelectedValue);\n\n        if (newValue >= 0.5 && newValue <= 10) {  // Ensure that the value is within the 1 to 10 range\n            if (sizeRuleOfThePad && sizeRuleOfTheCircleSilk && positionRuleOfTheTextSilk) {\n                // Update the pad size and silk circle size based on the property value\n                sizeRuleOfThePad.value = newValue.toString();\n                sizeRuleOfTheCircleSilk.value = (newValue + 0.5).toString();\n\n                // Update the Y position\n                const positionY = newValue / 2 + 1.5;  \n                positionRuleOfTheTextSilk.value = positionY.toString();\n            };\n        };\n    };\n};","behaviour_has_errors":false,"behaviour_is_derived":false,"controls":{"_dataStructureIsArray":true},"created_at":1781027472210,"description":"This is a generic test point with a circular pad, used to either monitor the state of the circuitry or to inject test signals, and debugging during development. The footprint size is selectable.\n\nStandard SMD test point size available: 0.5mm, 0.6mm, 0.7mm, 0.8mm, 0.9mm, 1.0mm, 2.0mm, 3.00mm, 4.00mm, 5.00mm, 6.00mm, 7.00mm","document_import_uid":"8db26db2-a266-470f-b953-6d09b4b44ef0","extracted_element_cache":{"e9cbb998-688e-40c0-820b-08a1f688dcc6":{"diagram_position":{"flip":false,"orientation":0,"scene_cursor_position":true,"x":9,"y":17.5},"label":"P1","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d645","version":"HEAD"},"properties":{"designator_prefix":{"name":"Designator Prefix","value":"P"},"part_type":{"name":"Part Type","value":"Terminal"},"pin_number":{"name":"Pin Number","value":"1"},"pin_type":{"name":"Pin Type","value":"Unspecified"},"symbol_pin_position":{"name":"Symbol Pin Position","value":{"data":{"x":0,"y":-10},"type":"vector2"}},"terminal_order":{"name":"Terminal Order","value":""}}}},"has_custom_name":true,"is_original":true,"name":"Generic Testpoint","owner_uid":"BvvmCewoPEamxFYjB0c5ERKB6rt1","part_uid":"cc313bba-fef2-4bbe-97b1-3f73a00a1c2d","pcbLayoutNodes":{"087763aa-d4a5-492b-9426-ff893056220a":{"name":"","parentUid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint","pcbNodeRuleSet":{"content":{"key":"content","order":2,"uid":"ff3823e9-d548-4a33-accc-e2ea1157dcce","value":"=this.element.designator"},"fontSize":{"key":"fontSize","order":4,"uid":"b79b69ad-6a6f-4682-9307-e1964af98167","value":"0.8"},"positionY":{"key":"positionY","order":3,"uid":"30601dfc-7bb3-4e48-acb9-a891a4e02bcd","value":"1.3"},"textAlign":{"key":"textAlign","order":3,"uid":"883cb94a-abc1-417b-ba83-4c7f12162bb0","value":"center"}},"type":"text","uid":"087763aa-d4a5-492b-9426-ff893056220a"},"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint":{"name":"Footprint","parentUid":"ROOT","pcbNodeRuleSet":{},"type":"footprint","uid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint"},"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint.Pads":{"name":"Pads","parentUid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint","pcbNodeRuleSet":{},"type":"container","uid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint.Pads"},"ROOT":{"name":"Root","parentUid":"PARENT_OF_ROOT","pcbNodeRuleSet":{},"type":"root","uid":"ROOT"},"a3e22c3e-0ca0-44fa-8711-8644c5a86e41":{"name":"Circle Shape","parentUid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint","pcbNodeRuleSet":{"size":{"key":"size","order":2,"uid":"853413f6-037a-43c5-a55c-734e60be1141","value":"1"},"strokeWidth":{"key":"strokeWidth","order":2,"uid":"4e874a21-7855-4a92-ae21-222589bfffae","value":"0.1"}},"type":"circle","uid":"a3e22c3e-0ca0-44fa-8711-8644c5a86e41"},"e9cbb998-688e-40c0-820b-08a1f688dcc6":{"name":"P1","parentUid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint.Pads","pcbNodeRuleSet":{"padShape":{"key":"padShape","order":2,"uid":"4c46424d-18a7-49ef-8c8a-2358df1d5c65","value":"circular"},"size":{"key":"size","order":2,"uid":"48957c7e-5271-4483-9c06-c9c6ee95de43","value":"0.5"}},"terminalId":"1","type":"pad","uid":"e9cbb998-688e-40c0-820b-08a1f688dcc6"}},"pcbLayoutRuleSets":{},"preview_i