_0805_2012Metric","6":"SMD_0815_2038Metric","7":"SMD_1020_2550Metric","8":"SMD_1206_3216Metric","9":"SMD_1210_3225Metric","10":"SMD_1218_3246Metric","11":"SMD_1812_4532Metric","12":"SMD_2010_5025Metric","13":"SMD_2512_6332Metric","14":"SMD_2816_7142Metric","15":"SMD_4020_10251Metric","16":"SMD_MELF_MMB-0207","17":"SMD_MicroMELF_MMU-0102","18":"SMD_MiniMELF_MMA-0204","19":"H_AXIAL-P7.62_D2.5","20":"H_AXIAL-P10.16_D2.5","21":"H_AXIAL-P12.7_D3.2","22":"H_AXIAL-P15.24_D3.2","23":"H_AXIAL-P20.32_D3.2","24":"H_AXIAL-P25.4_D_3.2","25":"H_AXIAL-P12.7_D3.6","26":"V_AXIAL-P2.54_D2.5","27":"V_AXIAL-P5.08_D2.5","28":"V_AXIAL-P2.54_D3.2","29":"V_AXIAL-P5.08_D3.2","30":"V_AXIAL-P5.08_D3.6","31":"V_AXIAL-P7.62_D3.6","32":"V_AXIAL-P5.08_D4.5","_dataStructureIsArray":true},"name":"Package","order":2,"uid":"dfa22e0a-7f6a-a9f0-7918-5ac4fd85e7d1","value":"SMD_0603_1608Metric"},"f5fb6d51-0168-733a-b622-482d9bb57e7a":{"name":"Datasheet URL","order":6,"uid":"f5fb6d51-0168-733a-b622-482d9bb57e7a","value":{"text":"","type":"link","url":""}}},"symbol_placements":{"MAIN":{"x":2040,"y":-5939.5}},"uid":"0f135ce7-d743-4312-8342-aa64c36d032c","updated_at":1787181706836},"0f87d1ae-348c-4abc-b703-fefcbdfce188":{"created_at":1787181709982,"diagram_position":{"x":0,"y":0},"label":"TP2","owner_uid":"ZlptFyOgRpgjoGMu10HDsDK5rgO2","part_uid":"cc313bba-fef2-4bbe-97b1-3f73a00a1c2d","part_version":"c476ed14-e8a6-4fc4-8762-2d33480ede7b","part_version_data_cache":{"assets":{"ad78f435-d26e-4ed3-a960-33e3673a3999":{"fileType":"svg","is3dModel":false,"isDefault":true,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":true,"label":"test-point.svg","name":"test-point","rawName":"testpoint.svg","storageName":"document_assets/testpoint-5c6338c0-265b-4a50-985b-029a00fe7f17.svg","uid":"ad78f435-d26e-4ed3-a960-33e3673a3999"}},"behaviour":"const terminalPadId = \"e9cbb998-688e-40c0-820b-08a1f688dcc6\"; // This has two nodes, one in schematic and for PCB. We only want the PCB node\nconst silkCircleId = \"a3e22c3e-0ca0-44fa-8711-8644c5a86e41\";\nconst silkTextId = \"087763aa-d4a5-492b-9426-ff893056220a\";\n\n// First cast to unknown, then to BaseNodeMixin\nconst terminalPadNode = flux.nodes.find((node) => {\n    const n = node as unknown as BaseNodeMixin; // Cast to unknown first, then to BaseNodeMixin\n    return n.id === terminalPadId && n.type === \"pcbLayoutNode\";\n}) as PcbLayoutNode | undefined;\n\nconst silkCircleNode = flux.getNodeById(silkCircleId) as PcbLayoutNode;\nconst textNodePosition = flux.getNodeById(silkTextId) as PcbLayoutNode;\n\n\n// Check if both terminalPadNode, silkCircleNode, textNodePosition are defined\nif (terminalPadNode && silkCircleNode && textNodePosition) {\n    const sizeRuleOfThePad = terminalPadNode.rules.find((rule) => rule.key === \"size\");\n    const sizeRuleOfTheCircleSilk = silkCircleNode.rules.find((rule) => rule.key === \"size\");\n    const positionRuleOfTheTextSilk = textNodePosition.rules.find((rule) => rule.key === \"positionY\");\n\n    flux.on(\"setup\", () => {\n        const property = flux.properties.find((prop) => prop.name === \"Testpoint Size\");\n        if (property) {\n            changeThePadSize(property.value);\n        };\n    });\n\n    flux.on(\"propertyChange\", (event: PropertyChangeEvent) => {\n        if (event.property_name === \"Testpoint Size\") {\n            changeThePadSize(event.value);\n        };\n    });\n\n    function changeThePadSize(newSelectedValue: any) {\n        // Check if newSelectedValue is null, undefined, or empty, and set defaults if so\n        if (!newSelectedValue || newSelectedValue === \"\") {\n            newSelectedValue = \"1\"; // Default value for pad and text position Y\n        };\n\n        const newValue = parseFloat(newSelectedValue);\n\n        if (newValue >= 0.5 && newValue <= 10) {  // Ensure that the value is within the 1 to 10 range\n            if (sizeRuleOfThePad && sizeRuleOfTheCircleSilk && positionRuleOfTheTextSilk) {\n                // Update the pad size and silk circle size based on the property value\n                sizeRuleOfThePad.value = newValue.toString();\n                sizeRuleOfTheCircleSilk.value = (newValue + 0.5).toString();\n\n                // Update the Y position\n                const positionY = newValue / 2 + 1.5;  \n                positionRuleOfTheTextSilk.value = positionY.toString();\n            };\n        };\n    };\n};","behaviour_has_errors":false,"behaviour_is_derived":false,"controls":{"_dataStructureIsArray":true},"created_at":1781027472210,"description":"This is a generic test point with a circular pad, used to either monitor the state of the circuitry or to inject test signals, and debugging during development. The footprint size is selectable.\n\nStandard SMD test point size available: 0.5mm, 0.6mm, 0.7mm, 0.8mm, 0.9mm, 1.0mm, 2.0mm, 3.00mm, 4.00mm, 5.00mm, 6.00mm, 7.00mm","document_import_uid":"8db26db2-a266-470f-b953-6d09b4b44ef0","extracted_element_cache":{"e9cbb998-688e-40c0-820b-08a1f688dcc6":{"diagram_position":{"flip":false,"orientation":0,"scene_cursor_position":true,"x":9,"y":17.5},"label":"P1","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d645","version":"HEAD"},"properties":{"designator_prefix":{"name":"Designator Prefix","value":"P"},"part_type":{"name":"Part Type","value":"Terminal"},"pin_number":{"name":"Pin Number","value":"1"},"pin_type":{"name":"Pin Type","value":"Unspecified"},"symbol_pin_position":{"name":"Symbol Pin Position","value":{"data":{"x":0,"y":-10},"type":"vector2"}},"terminal_order":{"name":"Terminal Order","value":""}}}},"has_custom_name":true,"is_original":true,"name":"Generic Testpoint","owner_uid":"BvvmCewoPEamxFYjB0c5ERKB6rt1","part_uid":"cc313bba-fef2-4bbe-97b1-3f73a00a1c2d","pcbLayoutNodes":{"087763aa-d4a5-492b-9426-ff893056220a":{"name":"","parentUid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint","pcbNodeRuleSet":{"content":{"key":"content","order":2,"uid":"ff3823e9-d548-4a33-accc-e2ea1