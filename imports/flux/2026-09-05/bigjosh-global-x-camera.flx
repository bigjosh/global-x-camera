:"3DV_AXIAL-P5.08_D2.5","rawName":"3DV_AXIAL-P5.08_D2.5.step","storageName":"document_assets/3DV_AXIAL-P5.08_D2.5-64e83535-7a96-93d4-8ff2-0934a8f6cd88.step","uid":"a91ca149-e2fc-a0c1-0430-907b648be076"},"a9290276-4e66-98d1-a03d-fa8aaf9af7c1":{"fileType":"step","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"3DSMD_2512_6332Metric.step","name":"3DSMD_2512_6332Metric","rawName":"3DSMD_2512_6332Metric.step","storageName":"document_assets/3DSMD_2512_6332Metric-b8a83f99-a2ca-e548-c69d-729c0d1b7f01.step","uid":"a9290276-4e66-98d1-a03d-fa8aaf9af7c1"},"b7eafec1-54b2-6a20-4368-6ccd765143b1":{"fileType":"kicad_mod","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"H_AXIAL-P12.7_D3.6.kicad_mod","name":"H_AXIAL-P12.7_D3.6","rawName":"R_Axial_DIN0411_L9.9mm_D3.6mm_P12.70mm_Horizontal.kicad_mod","storageName":"document_assets/R_Axial_DIN0411_L9.9mm_D3.6mm_P12.70mm_Horizontal-93aef1c8-2e0c-3ff9-4b7b-b9e98c442a64.kicad_mod","uid":"b7eafec1-54b2-6a20-4368-6ccd765143b1"},"bc9f62fa-0892-6e81-a5e8-7f51c19c7acd":{"fileType":"kicad_mod","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"V_AXIAL-P7.62_D3.6.kicad_mod","name":"V_AXIAL-P7.62_D3.6","rawName":"V_AXIAL-P7.62_D3.6.kicad_mod","storageName":"document_assets/V_AXIAL-P7.62_D3.6-cdb037c3-a934-7d6f-13b8-32b4acf71dda.kicad_mod","uid":"bc9f62fa-0892-6e81-a5e8-7f51c19c7acd"},"c0159464-eed7-7fbb-6f00-0f2dc0dc8dfb":{"fileType":"kicad_mod","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"H_AXIAL-P10.16_D2.5.kicad_mod","name":"H_AXIAL-P10.16_D2.5","rawName":"R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal.kicad_mod","storageName":"document_assets/R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal-34e05f5c-88d2-b871-689f-c74e9a13e61c.kicad_mod","uid":"c0159464-eed7-7fbb-6f00-0f2dc0dc8dfb"},"c523ed1c-e7a1-07c4