ts/SMD_7.1x6.5x5mm-abb6d0de-7923-4276-8dbd-7face7956594.kicad_mod","uid":"df32c6c0-3b88-46fe-84a8-a9b1bd493531"},"e084514f-db58-9937-a1f0-37c9b34bb786":{"fileType":"step","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"3DSMD_HCI-2212.step","name":"3DSMD_HCI-2212","rawName":"3DSMD_HCI-2212.step","storageName":"document_assets/3DSMD_HCI-2212-2ed02401-8967-20ca-a948-c1aa8c27b281.step","uid":"e084514f-db58-9937-a1f0-37c9b34bb786"},"eaba4294-d9a3-45d0-5de3-4a6d73314862":{"fileType":"step","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"3DSMD_0201_0603Metric.step","name":"3DSMD_0201_0603Metric","rawName":"3DSMD_0201_0603Metric.step","storageName":"document_assets/3DSMD_0201_0603Metric-c42dfbf5-7690-0197-6ad6-17c503abd087.step","uid":"eaba4294-d9a3-45d0-5de3-4a6d73314862"},"ef2226ba-0562-6823-9ed1-11dafec801d8":{"fileType":"step","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"3DSMD_PA4320.step","name":"3DSMD_PA4320","rawName":"3DSMD_PA4320.step","storageName":"document_assets/3DSMD_PA4320-84458fbb-c93c-ff81-efe0-15995c78a3ae.step","uid":"ef2226ba-0562-6823-9ed1-11dafec801d8"},"f13061ad-3748-8d05-ba05-11f1aa6ddf4d":{"fileType":"kicad_mod","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"SMD_1210_3225Metric.kicad_mod","name":"SMD_1210_3225Metric","rawName":"SMD_1210_3225Metric.kicad_mod","storageName":"document_assets/SMD_1210_3225Metric-0535c2f1-cdc2-486f-0c32-22883c4a3b07.kicad_mod","uid":"f13061ad-3748-8d05-ba05-11f1aa6ddf4d"},"f3b9de2c-2b0a-8926-0e9f-f2d803789abc":{"fileType":"kicad_mod","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"SMD_HCI-2212.kicad_mod","name":"SMD_HCI-2212","rawName":"SMD_HCI-2212.kicad_mod","storageName":"document_assets/SMD_HCI-2212-0a7b6f9d-b70b-36e0-a409-870f25ee4685.kicad_mod","uid":"f3b9de2c-2b0a-8926-0e9f-f2d803789abc"},"f53bd37a-8731-fef8-1b0b-6dab58cb172e":{"fileType":"step","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"3DSMD_1008_2520Metric.step","name":"3DSMD_1008_2520Metric","rawName":"3DSMD_1008_2520Metric.step","storageName":"document_assets/3DSMD_1008_2520Metric-4921b740-5347-bac2-1ed5-6c90f72b2ca1.step","uid":"f53bd37a-8731-fef8-1b0b-6dab58cb172e"},"f6ba2444-bd60-85cc-faed-7cd4be3ec9ac":{"fileType":"kicad_mod","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"SMD_1008_2520Metric.kicad_mod","name":"SMD_1008_2520Metric","rawName":"SMD_1008_2520Metric.kicad_mod","storageName":"document_assets/SMD_1008_2520Metric-4cc7a50b-84d9-392d-3701-dadf54fb84d8.kicad_mod","uid":"f6ba2444-bd60-85cc-faed-7cd4be3ec9ac"},"f93cf5fb-ff4b-de36-78ff-db8ca5f7ec10":{"fileType":"step","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"3DSMD_SRP2313AA.step","name":"3DSMD_SRP2313AA","rawName":"3DSMD_SRP2313AA.step","storageName":"document_assets/3DSMD_SRP2313AA-3058dec5-1730-95c3-e39d-ccfb3d1ca8b7.step","uid":"f93cf5fb-ff4b-de36-78ff-db8ca5f7ec10"}},"behaviour":"const footprintNode = flux.getNodeById(\"ebb4aea9-b967-e4af-67e3-929542394371\") as PcbLayoutNode;\nconst modelNode = flux.getNodeById(\"3d59e9a9-6410-8a17-e49e-984f31beee43\") as PcbLayoutNode;\n\n// This will return array of all assets with file type .kicad_mod\nconst footprintAssetNotSorted = flux.assets.filter((asset) => asset.fileType === \"kicad_mod\").map((asset) => asset.name);\nconst footprintAssetId = footprintAssetNotSorted.sort();\n\n// This will return array of all assets with file type .step\nconst modelAssetIdNotSorted = flux.assets.filter((asset) => asset.fileType === \"step\").map((asset) => asset.name);\nconst modelAssetId = modelAssetIdNotSorted.sort();\n\nif (footprintNode || modelNode) {\n    const assetFootprintRule = footprintNode.rules.find((rule) => rule.key === \"asset\");\n    const assetModelRule = modelNode.rules.find((rule) => rule.key === \"asset\");\n\n    flux.on(\"setup\", () => {\n        const property = flux.properties.find((prop) => prop.name === \"Package\");\n        if (property) {\n            changeFootprintAsset(property.value);\n            changeModelAsset(property.value)\n        }\n    });\n\n    flux.on(\"propertyChange\", (event: PropertyChangeEvent) => {\n        if (event.property_name === \"Package\") {\n            changeFootprintAsset(event.value);\n            changeModelAsset(event.value);\n        }\n    });\n\n    function changeFootprintAsset(propertyValue: any) {\n        if (assetFootprintRule) {\n            const index = footprintAssetId.indexOf(propertyValue);\n            if (index !== -1) {\n                assetFootprintRule.value = footprintAssetId[index];\n                footprintNode.name = footprintAssetId[index];\n            } else {\n                assetFootprintRule.value = \"SMD_0603_1608Metric\";\n                footprintNode.name = \"SMD_0603_1608Metric\";\n            }\n        }\n    }\n\n    function changeModelAsset(propertyValue: any) {\n        if (assetModelRule) {\n            let index = footprintAssetId.indexOf(propertyValue);\n            if (index !== -1 && index < modelAssetId.length) {\n                assetModelRule.value = modelAssetId[index];\n                modelNode.name = modelAssetId[index];\n            } else {\n                assetModelRule.value = \"3DSMD_0603_1608Metric\";\n                modelNode.name = \"3DSMD_0603_1608Metric\";\n            }\n        }\n    }\n};","behaviour_has_errors":false,"behaviour_is_derived":false,"controls":{"_dataStructureIsArray":true},"created_at":1781027188757,"description":"A generic fixed inductor suitable for rapid circuit topology development. The footprint automatically adapts based on the selected package, supporting standard SMD sizes (e.g., 0402, 0603, 0805) as well as well-known inductor packages such as SDR1806, PA4320, SRN6028, and SRR1260. \n\nStandard inductor values:\n1.0 nH, 10 nH, 100 nH, 1.0 µH, 10 µH, 100 µH, 1.0 mH\n1.2 nH, 12 nH, 120 nH, 1.2 µH, 12 µH, 120 µH, 1.2 mH\n1.5 nH, 15 nH, 150 nH, 1.5 µH, 15 µH, 150 µH, 1.5 mH\n1.8 nH, 18 nH, 180 nH, 1.8 µH, 18 µH, 180 µH, 1.8 mH\n2.2 nH, 22 nH, 220 nH, 2.2 µH, 22 µH, 220 µH, 2.2 mH\n2.7 nH, 27 nH, 270 nH, 2.7 µH, 27 µH, 270 µH, 2.7 mH\n3.3 nH, 33 nH, 330 nH, 3.3 µH, 33 µH, 330 µH, 3.3 mH\n3.9 nH, 39 nH, 390 nH, 3.9 µH, 39 µH, 390 µH, 3.9 mH\n4.7 nH, 47 nH, 470 nH, 4.7 µH, 47 µH, 470 µH, 4.7 mH\n5.6 nH, 56 nH, 560 nH, 5.6 µH, 56 µH, 560 µH, 5.6 mH\n6.8 nH, 68 nH, 680 nH, 6.8 µH, 68 µH, 680 µH, 6.8 mH\n8.2 nH, 82 nH, 820 nH, 8.2 µH, 82 µH, 820 µH, 8.2 mH\n\n#generics #CommonPartsLibrary","document_import_uid":"8e7aee2c-70ab-165d-83cd-85d02372ae0d","extracted_element_cache":{"31c6f0d0-50f6-960d-170d-c511f55a9b68":{"diagram_position":{"flip":false,"orientation":0,"scene_cursor_position":true,"x":21.5,"y":44.2},"label":"P2","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d645","version":"HEAD"},"properties":{"designator_prefix":{"name":"Designator Prefix","value":"P"},"part_type":{"name":"Part Type","value":"Terminal"},"pin_number":{"name":"Pin Number","value":"2"},"pin_type":{"name":"Pin Type","value":"Unspecified"},"symbol_pin_position":{"name":"Symbol Pin Position","value":{"data":{"x":16,"y":-2},"type":"vector2"}},"terminal_order":{"name":"Terminal Order","value":""}}},"b768ec21-c56b-dbb5-cb30-f29d59675d9b":{"diagram_position":{"flip":false,"orientation":-3.141592653589793,"scene_cursor_position":true,"x":-28.1,"y":44.2},"label":"P1","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d645","version":"HEAD"},"properties":{"designator_prefix":{"name":"Designator Prefix","value":"P"},"part_type":{"name":"Part Type","value":"Termi